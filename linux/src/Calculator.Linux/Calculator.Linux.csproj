<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Calculator.Linux</RootNamespace>
    <AssemblyName>Calculator.Linux</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Task 1 placeholder: proves `dotnet build/run` + Avalonia restore.
         Task 4 replaces this console entry point with the Avalonia App. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <!--
      AUD-S2-002: Avalonia.FreeDesktop 11.3.6 pins Tmds.DBus.Protocol 0.21.2,
      which carries CVE-2026-39959 / GHSA-xrw6-gwf8-vvr9 (CVSS 7.1 High):
      a peer on the same D-Bus bus can spoof signals, exhaust file descriptors,
      or crash the process with a malformed message body. Fixed in 0.21.3.
      Pin the patched version so it ships in the .deb.
      https://github.com/advisories/GHSA-xrw6-gwf8-vvr9
    -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream default currency pairs (single source, linked not copied). -->
    <Content Include="..\..\..\src\Calculator.ViewModels\DataLoaders\DefaultFromToCurrency.json" Link="DefaultFromToCurrency.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      AUD-NEW-1: the native engine must ship next to the apphost in EVERY
      publish mode (plain `dotnet publish -c Release -r linux-x64`, not just
      the .deb built by build-deb.sh). Published under runtimes/<rid>/native
      so it lands in the publish root for that RID. Conditioned on the file
      existing so a repo without the CMake build still restores/builds the
      managed layer; the resolver falls back to the in-tree path then.
    -->
    <Content Include="..\..\build\calc-manager\libCalcManager.so"
             Condition="Exists('..\..\build\calc-manager\libCalcManager.so')">
      <Link>runtimes/linux-x64/native/libCalcManager.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
